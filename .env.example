# Copy to .env and set a strong secret
JWT_SECRET=change-me-to-a-random-64-char-hex

# Web push (webpush.php). Generate a VAPID keypair for the real values --
# without these, savePushSubscription/pushNotification just no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Verbose per-request logging (emails, IPs, post snippets, session ids).
# Leave false in production; the logs rotate but nothing trims old ones.
APP_DEBUG=false

# Only needed if uploads aren't at <domain>/public_html/media (e.g. the old layout)
MEDIA_DIR=

# Moderation: each new report is emailed here (unset = no email, a warning
# in the log). CONTACT_EMAIL is the address suspended users are told to write to.
ADMIN_REPORT_EMAIL=
CONTACT_EMAIL=

# Terms of Use version users must accept in the apps (bump when the terms
# change), and where the terms are published.
TERMS_VERSION=1
TERMS_URL=/terms
